{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Modern portfolio site with Astro v5, TypeScript, and React Islands",
  "keywords": [
    "astro",
    "blog",
    "mdx",
    "portfolio",
    "react",
    "tailwindcss",
    "typescript"
  ],
  "homepage": "https://divkix.me",
  "bugs": {
    "url": "https://github.com/divkix/divkix.me/issues"
  },
  "license": "MIT",
  "author": "Divanshu Chauhan <divkix@divkix.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/divkix/divkix.me.git"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-posts-metadata.js && node scripts/generate-og-images.js",
    "build": "pnpm run prebuild && tsx scripts/validate-content.ts && astro build && node scripts/generate-flat-sitemap.js && tsx scripts/submit-indexnow.ts",
    "preview": "astro preview",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "type-check": "astro check && tsc --noEmit",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "check:citations": "tsx scripts/check-citation-density.ts",
    "audit:seo": "tsx scripts/seo-production-audit.ts",
    "prepare": "vp config || true"
  },
  "dependencies": {
    "@4hse/astro-llms-txt": "^1.0.5",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "7.3.2",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "knip": "^6.35.1",
    "png-to-ico": "^3.0.2",
    "rehype-external-links": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15",
    "not IE 11",
    "not dead"
  ],
  "packageManager": "pnpm@11.10.0"
}
