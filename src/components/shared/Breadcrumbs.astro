---
export interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 list-none m-0 p-0">
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="flex items-center gap-x-2 min-w-0">
            {index > 0 && (
              <span class="text-border" aria-hidden="true">
                /
              </span>
            )}
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="hover:text-primary transition-colors link-underline-grow"
              >
                {item.name}
              </a>
            ) : (
              <span class="text-foreground truncate" aria-current="page">
                {item.name}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
