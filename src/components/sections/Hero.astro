---
import SocialIcons from "@/components/shared/SocialIcons.astro";
import { siteConfig } from "@/data/site.config";

const asciiWordmark = String.raw` ____ _____     ___  _______  __
|  _ \_ _\ \   / / |/ /_ _\ \/ /
| | | | | \ \ / /| ' / | | \  /
| |_| | |  \ V / | . \ | | /  \
|____/___|  \_/  |_|\_\___/_/\_\
`.trimEnd();

const stats = [
  { label: "users", value: siteConfig.facts.impact },
  { label: "projects", value: siteConfig.facts.projects },
  { label: "open source", value: siteConfig.facts.oss },
] as const;
---

<section id="hero" class="text-band" aria-labelledby="hero-heading">
  <div class="grid gap-(--space-xl) md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] md:items-start min-w-0">
    <div class="min-w-0 space-y-(--space-md)">
      <p class="ascii-prompt">
        <span class="ascii-prompt-user">divkix@cloudflare</span>:<span class="ascii-prompt-path">~</span>$ whoami
        <span class="ascii-cursor" aria-hidden="true"></span>
      </p>

      <pre class="ascii-wordmark" aria-hidden="true">{asciiWordmark}</pre>

      <h1
        id="hero-heading"
        class="font-display text-(length:--text-display) leading-[1.02] text-foreground min-w-0 overflow-wrap-anywhere mt-(--space-xs)"
      >
        {siteConfig.name}
      </h1>

      <p class="prose-measure text-(length:--text-md) md:text-lg text-foreground/85 leading-relaxed">
        {siteConfig.heroSummary}
      </p>

      <p class="prose-measure text-base text-muted-foreground leading-relaxed">
        {siteConfig.heroProof}
      </p>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-3 pt-(--space-xs)">
        <a href="/#projects" class="btn-primary gap-(--space-2xs)">
          <span aria-hidden="true">[</span>
          <span>See selected work</span>
          <span aria-hidden="true">]</span>
        </a>
        <a href="/resume" class="btn-secondary gap-(--space-2xs)">
          <span aria-hidden="true">[</span>
          <span>View resume</span>
          <span aria-hidden="true">]</span>
        </a>
        <a
          href="/blog"
          class="text-sm text-muted-foreground hover:text-foreground link-underline-grow transition-colors"
        >
          Recent writing
        </a>
        <a
          href="/divkix"
          class="text-sm text-muted-foreground hover:text-foreground link-underline-grow transition-colors"
        >
          Identity profile
        </a>
      </div>

      <div class="ascii-panel">
        <p class="ascii-panel-title">$ divkix --stats</p>
        <dl class="ascii-stats" aria-label="At-a-glance stats">
          {
            stats.map((stat) => (
              <div class="ascii-stat">
                <dt>
                  {stat.label}
                  <span class="ascii-leader" aria-hidden="true"></span>
                </dt>
                <dd>{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="pt-(--space-2xs)">
        <SocialIcons size="sm" />
      </div>
    </div>

    <figure
      class="ascii-window m-0 w-full max-w-[16rem] sm:max-w-[18rem] md:max-w-none justify-self-start md:justify-self-end md:sticky md:top-[calc(4.5rem+var(--space-md))]"
    >
      <figcaption class="ascii-window-bar" aria-hidden="true">
        <span>[ divkix@cloudflare:~/portrait.webp ]</span>
        <span>[ 480x600 ]</span>
      </figcaption>
      <img
        src={siteConfig.authorImage}
        alt={`Portrait of ${siteConfig.name}`}
        class="w-full aspect-4/5 object-cover object-[center_22%]"
        width="480"
        height="600"
        loading="eager"
        decoding="async"
      />
    </figure>
  </div>
</section>
