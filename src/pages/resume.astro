---
import ExperienceBentoStatic from "@/components/sections/experience/ExperienceBentoStatic.astro";
import { siteConfig } from "@/data/site.config";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { generateFAQPageSchema, generateProfilePageSchema } from "@/lib/schema";
import { baseUrl } from "@/lib/seo";

const faqPageSchema = generateFAQPageSchema(
  [
    {
      q: "What is your experience?",
      a: "Software Engineer Intern at Cloudflare (Emerging Technology & Incubation, June 2026 – Present) building engineering tooling and developer-experience infrastructure for production Workers workloads. Previously Engineering Tutor, Instructional Aide, and Undergraduate TA at Arizona State University (Aug. 2023 – May 2026) tutoring CSE205, CSE230, CSE240, CSE310, CSE330, CSE360 and supporting CSE110 for 456 students. Earlier Finance and Technology Intern at Xrossways INC. (May 2022 – Aug. 2022). MS in Computer Science, ASU, Aug. 2025 – May 2026 (GPA 3.889/4.00); BS, ASU, Jan. 2022 – May 2025 (Magna Cum Laude, GPA 3.78/4.00).",
    },
    {
      q: "What technologies do you use?",
      a: "Languages: TypeScript, JavaScript, Python, Go, Java, C/C++. Frameworks: React, Node.js, Express, Vite, Astro, REST APIs. Cloud & Infrastructure: Cloudflare Workers, D1, R2, Queues, Durable Objects, Docker, Linux. Data & Systems: PostgreSQL, SQLite, MongoDB, WebSockets, SSE, Observability, Git, Gemini API, LLM workflows.",
    },
  ],
  `${baseUrl}/resume`,
);

const resumePageSchema = generateProfilePageSchema(
  `Resume | ${siteConfig.name} — ${siteConfig.seo.jobTitle}`,
  `Resume of ${siteConfig.name} — ${siteConfig.tagline}`,
  `${baseUrl}/resume`,
  {
    datePublished: "2025-01-01",
    articleSection: "Resume",
  },
);
---

<SiteLayout
  title={`Resume | ${siteConfig.name} — ${siteConfig.seo.jobTitle}`}
  description={`Resume of ${siteConfig.name} — ${siteConfig.tagline}`}
  ogImage={`${baseUrl}/og/resume.png`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(resumePageSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

  <article class="min-w-0">
    <section class="text-band" aria-labelledby="resume-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 mb-(--space-sm)">
        <p class="mast-line">Resume</p>
        <a
          href="/Divanshu_Chauhan_Resume.pdf"
          class="text-sm text-primary link-underline-grow uppercase tracking-[0.06em]"
          target="_blank"
          rel="noopener"
        >
          Download PDF
        </a>
      </div>

      <h1
        id="resume-heading"
        class="font-display text-(length:--text-display-s) leading-[1.05] tracking-(--tracking-display) text-foreground m-0"
      >
        {siteConfig.name}
      </h1>

      <p class="prose-measure text-(length:--text-md) md:text-lg text-foreground/85 leading-relaxed mt-(--space-md)">
        {siteConfig.tagline}
      </p>

      <p class="prose-measure text-base text-foreground/85 leading-relaxed mt-(--space-md)">
        {siteConfig.openToWork}
      </p>

      <div class="accent-line mt-(--space-xl)! mb-0!" aria-hidden="true"></div>
    </section>

    <section class="text-band pt-(--space-md)! space-y-(--space-md)">
      <h2 class="font-display text-(length:--text-xl) leading-tight text-foreground m-0">
        Summary
      </h2>
      <p class="prose-measure text-base leading-relaxed text-foreground">
        {siteConfig.about}
      </p>
    </section>

    <div class="text-band pt-(--space-md)!">
      <hr class="hairline-rule mb-(--space-xl)" />
      <ExperienceBentoStatic />
    </div>

    <section class="text-band pt-(--space-md)! pb-(--space-3xl)">
      <div class="space-y-(--space-xs)">
        <h2 class="font-display text-(length:--text-xl) leading-tight text-foreground m-0">
          Skills
        </h2>
        <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
          {siteConfig.skills.map((skill) => (
            <li class="text-sm bg-muted px-3 py-1.5 rounded-sm text-foreground/85">
              {skill.name}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="text-band pt-(--space-md)! pb-(--space-3xl)">
      <div class="space-y-(--space-xs)">
        <h2 class="font-display text-(length:--text-xl) leading-tight text-foreground m-0">Projects</h2>
        <ul class="space-y-(--space-md) list-none m-0 p-0">
          {siteConfig.projects.map((project) => (
            <li>
              <p class="font-display text-lg font-medium">{project.name}</p>
              <p class="text-xs text-muted-foreground">
                {project.links.map((link) => link.label).join(" · ")}
              </p>
              <p class="text-sm text-foreground/75 leading-relaxed mt-1">{project.desc}</p>
              <p class="text-xs text-muted-foreground">{project.tags.join(" · ")}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="text-band pt-(--space-md)! pb-(--space-3xl)">
      <div class="space-y-(--space-xs)">
        <h2 class="font-display text-(length:--text-xl) leading-tight text-foreground m-0">
          Links
        </h2>
        <ul class="flex flex-wrap gap-x-4 gap-y-2 list-none m-0 p-0">
          {siteConfig.socials.map((social) => (
            <li>
              <a href={social.href} class="text-sm text-primary link-underline-grow" rel="noopener noreferrer">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</SiteLayout>
