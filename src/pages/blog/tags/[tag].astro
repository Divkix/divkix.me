---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Breadcrumbs from "@/components/shared/Breadcrumbs.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import {
  generateBreadcrumbSchema,
  generateCollectionPageSchema,
} from "@/lib/schema";
import { baseUrl, slugifyTag, tagPath } from "@/lib/seo";
import { calculateReadingTime, formatDate } from "@/lib/utils";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const publishedPosts = allPosts.filter(
    (post: CollectionEntry<"blog">) => post.data.published === true,
  );

  const tagCounts = new Map<string, number>();
  for (const post of publishedPosts) {
    for (const tag of post.data.tags) {
      const normalized = tag.toLowerCase();
      tagCounts.set(normalized, (tagCounts.get(normalized) ?? 0) + 1);
    }
  }

  const tagsBySlug = new Map<string, string>();
  for (const [tag, count] of tagCounts) {
    if (count >= 2) tagsBySlug.set(slugifyTag(tag), tag);
  }

  const multiPostTagsArray = Array.from(tagCounts.keys()).filter(
    (tag) => (tagCounts.get(tag) ?? 0) >= 2,
  );

  return Array.from(tagsBySlug.entries()).map(([slug, tag]) => ({
    params: { tag: slug },
    props: {
      tag,
      slug,
      posts: publishedPosts.filter((p: CollectionEntry<"blog">) =>
        p.data.tags.some((t: string) => slugifyTag(t) === slug),
      ),
      multiPostTags: multiPostTagsArray,
    },
  }));
}

interface Props {
  tag: string;
  slug: string;
  posts: CollectionEntry<"blog">[];
  multiPostTags: string[];
}

const { tag, slug, posts, multiPostTags } = Astro.props;

type PostWithReadingTime = {
  post: CollectionEntry<"blog">;
  readingTime: string;
};

const postsWithReadingTime: PostWithReadingTime[] = posts
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .map((post: CollectionEntry<"blog">) => ({
    post,
    readingTime: `${calculateReadingTime(post.body)} min read`,
  }));

const tagUrl = `${baseUrl}${tagPath(tag)}`;

const collectionPageSchema = generateCollectionPageSchema(
  `Posts tagged "${tag}"`,
  `Blog posts tagged with ${tag}.`,
  tagUrl,
  {
    articleSection: "Blog",
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.map(
        (post: CollectionEntry<"blog">, index: number) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `${baseUrl}/blog/${post.id}`,
          name: post.data.title,
        }),
      ),
    },
  },
);

const breadcrumbItems = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/blog" },
  { name: tag, href: tagPath(tag) },
];

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", item: baseUrl },
  { name: "Blog", item: `${baseUrl}/blog` },
  {
    name: `"${tag}" Posts`,
    item: tagUrl,
  },
]);

const displayTag = tag.charAt(0).toUpperCase() + tag.slice(1);
const pageTitle = `Posts tagged "${displayTag}" — Blog`;
const pageDescription = `Browse ${posts.length} blog posts tagged with "${tag}". Articles about software development, AI, and engineering.`;
---

<BlogLayout title={pageTitle} description={pageDescription}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(collectionPageSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <div class="text-band">
    <div class="space-y-12">
      <div class="space-y-4">
        <Breadcrumbs items={breadcrumbItems} />

        <p class="mast-line">Posts tagged</p>
        <h1 class="font-display text-(length:--text-display) m-0">
          {displayTag}
        </h1>
        <p class="text-xl text-foreground/70">
          {posts.length} {posts.length === 1 ? "post" : "posts"} tagged with
          "{tag}"
        </p>
      </div>

      {posts.length === 0 ? (
        <p class="text-foreground/60">No posts found with this tag.</p>
      ) : (
        <div class="space-y-6">
          {
            postsWithReadingTime.map((item: PostWithReadingTime) => (
              <article class="surface-raised hover:border-primary/50 transition-colors rounded-none overflow-hidden border border-border/40">
                <div class="p-6 space-y-4">
                  <div class="flex items-center justify-between gap-4 flex-wrap">
                    <div class="flex items-center gap-2">
                      {item.post.data.featured && (
                        <span class="text-xs px-2 py-0.5 bg-primary/15 text-primary border border-primary/20 rounded font-medium">
                          Featured
                        </span>
                      )}
                      <span class="text-sm px-3 py-1 bg-secondary text-secondary-foreground rounded">
                        {item.readingTime}
                      </span>
                    </div>
                    <time
                      datetime={item.post.data.date}
                      class="text-sm text-foreground/60"
                    >
                      {formatDate(item.post.data.date)}
                    </time>
                  </div>
                  <h2 class="font-display text-(length:--text-xl) transition-colors">
                    <a
                      href={`/blog/${item.post.id}`}
                      class="hover:text-primary transition-colors link-underline-grow"
                    >
                      {item.post.data.title}
                    </a>
                  </h2>
                  {item.post.data.excerpt && (
                    <p class="text-base text-foreground/70">
                      {item.post.data.excerpt}
                    </p>
                  )}
                  {item.post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {item.post.data.tags.map((t: string) => (
                        multiPostTags.includes(t.toLowerCase()) ? (
                          <a
                            href={tagPath(t)}
                            class={
                              slugifyTag(t) === slug
                                ? "text-xs px-2 py-1 bg-primary text-primary-foreground rounded link-underline-grow"
                                : "text-xs px-2 py-1 border border-border/60 rounded hover:border-primary/60 hover:text-primary transition-colors link-underline-grow"
                            }
                          >
                            {t}
                          </a>
                        ) : (
                          <span class="text-xs px-2 py-1 border border-border/60 rounded text-foreground/70">
                            {t}
                          </span>
                        )
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      )}
    </div>
  </div>
</BlogLayout>
