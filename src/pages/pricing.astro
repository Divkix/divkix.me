---
import { siteConfig } from "@/data/site.config";
import SiteLayout from "@/layouts/SiteLayout.astro";
import {
  generateBreadcrumbSchema,
  generateFAQPageSchema,
  generateOfferSchema,
  generateProfilePageSchema,
} from "@/lib/schema";
import { baseUrl } from "@/lib/seo";

const pricingUrl = `${baseUrl}/pricing`;
const pricingDescription =
  "Freelance rates from Divanshu Chauhan: web development from $2,000, consulting at $150/hour, code audits, technical SEO, and AI integration work.";

const pricingPageSchema = generateProfilePageSchema(
  "Freelance Services & Pricing",
  pricingDescription,
  pricingUrl,
  {
    datePublished: "2025-01-01",
    articleSection: "Services",
  },
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", item: baseUrl },
  { name: "Pricing", item: pricingUrl },
]);

const services = [
  {
    name: "Web Development",
    price: "Starting at $2,000 per project",
    description:
      "Full-stack web applications, APIs, and portfolio sites built with modern frameworks.",
  },
  {
    name: "Technical Consulting",
    price: "$150/hour",
    description:
      "Architecture reviews, technology selection, and engineering strategy sessions.",
  },
  {
    name: "Code Review & Audits",
    price: "$500 per project",
    description:
      "Security audits, performance analysis, and code quality assessments.",
  },
  {
    name: "SEO Optimization",
    price: "$1,000 per project",
    description:
      "Technical SEO, structured data, and content optimization for search engines.",
  },
  {
    name: "AI Integration",
    price: "Custom pricing",
    description:
      "LLM-powered features, AI agent workflows, and intelligent automation.",
  },
];

const pricingFaq = [
  {
    q: "How do I get a quote?",
    a: `Email ${siteConfig.email} with what you want built, your timeline, and your budget range. I'll reply with either a fixed project quote or an hourly estimate before any work starts.`,
  },
  {
    q: 'What does "starting at" mean?',
    a: "It's the floor for a small, well-scoped project. The final price depends on scope, integrations, and deadline, and is agreed in writing up front so there are no surprise invoices.",
  },
  {
    q: "What stack do you build with?",
    a: "Mostly TypeScript, with Cloudflare Workers or a small VPS for hosting and PostgreSQL or D1 for data. If you already have a stack, I'll work in it.",
  },
  {
    q: "Why is AI integration custom-priced?",
    a: "Costs swing widely with model choice, data volume, and how much evaluation the feature needs. A short consulting call usually pins down the scope before I quote it.",
  },
  {
    q: "Are you available for full-time roles?",
    a: siteConfig.openToWork,
  },
];

const pricingFaqSchema = generateFAQPageSchema(pricingFaq, pricingUrl);
---

<SiteLayout
  title="Freelance Services & Pricing — Divanshu Chauhan"
  description={pricingDescription}
  ogImage={`${baseUrl}/og/pricing.png`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(pricingPageSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(services.map((service) => generateOfferSchema(service)))} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(pricingFaqSchema)} />

  <div class="text-band space-y-(--space-xl)">
    <!-- Header -->
    <div class="space-y-(--space-md) text-center">
      <p class="mast-line">Services</p>
      <h1 class="font-display text-(length:--text-display)">Freelance Services & Pricing</h1>
      <p class="text-(length:--text-xl) text-foreground/70">
        Services and rates for freelance work
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid gap-(--space-md) md:grid-cols-2">
      {services.map((service) => (
        <div class="surface-raised p-(--space-lg) space-y-(--space-md)">
          <div class="space-y-(--space-xs)">
            <h2 class="font-display text-(length:--text-xl)">{service.name}</h2>
            <p class="text-(length:--text-lg) font-bold text-primary">{service.price}</p>
          </div>
          <p class="text-foreground/70">{service.description}</p>
        </div>
      ))}
    </div>

    <!-- FAQ -->
    <section class="space-y-(--space-md)" aria-labelledby="pricing-faq-heading">
      <h2 id="pricing-faq-heading" class="font-display text-(length:--text-xl)">
        Common questions
      </h2>
      <dl class="space-y-(--space-md)">
        {pricingFaq.map((item) => (
          <div class="space-y-(--space-xs)">
            <dt class="font-semibold">{item.q}</dt>
            <dd class="text-foreground/70 leading-relaxed">{item.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Download Link -->
    <div class="text-center">
      <a
        href="/pricing.md"
        class="inline-flex items-center gap-2 text-primary link-underline-grow"
        download
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" x2="12" y1="15" y2="3" />
        </svg>
        Download pricing.md
      </a>
    </div>

    <!-- Contact -->
    <div class="text-center space-y-(--space-md) pt-(--space-lg) border-t border-border">
      <p class="text-foreground/60">
        For project inquiries or custom quotes, reach out:
      </p>
      <div class="flex items-center justify-center gap-(--space-md)">
        <a
          href={`mailto:${siteConfig.email}`}
          class="text-primary link-underline-grow"
        >
          {siteConfig.email}
        </a>
        <span class="text-foreground/40" aria-hidden="true">·</span>
        <a href="/" class="text-primary link-underline-grow">divkix.me</a>
      </div>
    </div>
  </div>
</SiteLayout>
