# Security headers
/*
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.divkix.me; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://analytics.divkix.me https://formspree.io; font-src 'self'; form-action 'self' https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Cache headers for Cloudflare Workers static assets
# Immutable caching only for Astro content-hashed output
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Named public assets can change without a filename change
/og/*
  Cache-Control: public, max-age=86400, must-revalidate

/favicon*
  Cache-Control: public, max-age=86400, must-revalidate

/android-chrome-*
  Cache-Control: public, max-age=86400, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

/full-logo.png
  Cache-Control: public, max-age=86400, must-revalidate

/divanshu-chauhan.webp
  Cache-Control: public, max-age=86400, must-revalidate

/transparent-text*
  Cache-Control: public, max-age=86400, must-revalidate

/Divanshu_Chauhan_Resume.pdf
  Cache-Control: public, max-age=86400, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate

# Revalidation cache for HTML pages (1 hour)
/
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/html; charset=utf-8
  # Agent discovery: Link headers per RFC 8288
  Link: </llms.txt>; rel="describedby"; title="LLMs.txt"
  Link: </sitemap.xml>; rel="sitemap"; title="Sitemap"
  Link: </rss.xml>; rel="alternate"; type="application/rss+xml"; title="Blog RSS Feed"
  Link: <mailto:divkix@divkix.me>; rel="author"; title="Contact"

/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/html; charset=utf-8

# Cache blog HTML with short-lived revalidation
/blog/*
  Cache-Control: public, max-age=3600, must-revalidate

# pricing.md is a hand-authored static file served as-is
/pricing.md
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/markdown; charset=utf-8

# llms.txt files - noindex
/llms.txt
  X-Robots-Tag: noindex

/llms-full.txt
  X-Robots-Tag: noindex

/llms-small.txt
  X-Robots-Tag: noindex
